{
  "version": 2,
  "buildCommand": "node scripts/build-book-staging.mjs --legacy-rollback --out-dir dist-staging",
  "outputDirectory": "dist-staging",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/trpc/(.*)",
      "destination": "/api/trpc"
    },
    {
      "source": "/api/oauth/(.*)",
      "destination": "/api/server"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
